package ui

import "core:math"
import rl "vendor:raylib"

// Hand-drawn pixel icons. '#' is a filled pixel; one icon pixel is one point,
// the same size as one pixel of the UI font.

Icon :: enum u8 {
	Select,
	Move,
	Push_Pull,
	Add,
	Undo,
	Redo,
	Settings,
	Menu,
	Check,
	Chevron_Down,
	Arrow_Right,
	Arrow_Down,
	Close,
	Panel,
	Turned,
	Swept,
}

