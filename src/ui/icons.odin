// Draws an icon centred on `c`, `scale` points per icon pixel.
icon :: proc(kind: Icon, c: Vec2, col: Color, scale: f32 = 1) {
	rows := ICONS[kind]
	mirror := false
	if kind == .Redo {
		rows = ICONS[.Undo]
		mirror = true
	}
	h := len(rows)
	if h == 0 {return}
	w := len(rows[0])
	x0 := math.round(c.x - f32(w) * scale * 0.5)
	y0 := math.round(c.y - f32(h) * scale * 0.5)
	for row, y in rows {
		// merge runs of filled pixels into one rectangle
		x := 0
		for x < len(row) {
			if row[x] != '#' {
				x += 1
				continue
			}
			start := x
			for x < len(row) && row[x] == '#' {x += 1}
			px := f32(start)
			if mirror {px = f32(w - x)}
			rl.DrawRectangleRec({x0 + px * scale, y0 + f32(y) * scale, f32(x - start) * scale, scale}, col)
		}
	}
}

icon_size :: proc(kind: Icon) -> Vec2 {
	rows := ICONS[kind == .Redo ? .Undo : kind]
	if len(rows) == 0 {return {}}
	return {f32(len(rows[0])), f32(len(rows))}
}
